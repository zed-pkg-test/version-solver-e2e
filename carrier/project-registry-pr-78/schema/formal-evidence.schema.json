{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/project-registry/schema/formal-evidence.schema.json",
  "title": "Implementation-linked formal-method evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authority": { "const": "ORESoftware/project-registry" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "property", "implementation", "assumptions", "bounds", "evidenceClasses", "evidence", "negativeControl"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "property": { "type": "string", "minLength": 1 },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "paths"],
          "properties": {
            "repository": { "$ref": "#/$defs/repo" },
            "commit": { "$ref": "#/$defs/sha" },
            "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "bounds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidenceClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["declarations", "models", "implementation-linked-tests", "cross-runtime-tests"] },
          "contains": { "const": "implementation-linked-tests" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "repository", "commit", "path"],
            "properties": {
              "class": { "enum": ["declarations", "models", "implementation-linked-tests", "cross-runtime-tests"] },
              "repository": { "$ref": "#/$defs/repo" },
              "commit": { "$ref": "#/$defs/sha" },
              "path": { "type": "string", "minLength": 1 },
              "tool": { "type": "string" },
              "command": { "type": "string" }
            }
          }
        },
        "negativeControl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutation", "test", "detected"],
          "properties": {
            "mutation": { "type": "string", "minLength": 1 },
            "test": { "type": "string", "minLength": 1 },
            "detected": { "const": true }
          }
        }
      }
    }
  }
}
