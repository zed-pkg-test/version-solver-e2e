{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/project-registry/schema/certification-evidence.schema.json",
  "title": "Exact-head cross-organization CI certification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "carrier", "workflow", "toolchains", "commands", "artifacts", "result", "runner"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "dependencies"],
      "properties": {
        "repository": { "$ref": "#/$defs/repo" },
        "commit": { "$ref": "#/$defs/sha" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commit"],
            "properties": {
              "repository": { "$ref": "#/$defs/repo" },
              "commit": { "$ref": "#/$defs/sha" }
            }
          }
        }
      }
    },
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "kind"],
      "properties": {
        "repository": { "$ref": "#/$defs/repo" },
        "kind": { "enum": ["source-repository", "alternate-organization"] },
        "pullRequest": { "type": "integer", "minimum": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "revision"],
      "properties": {
        "repository": { "$ref": "#/$defs/repo" },
        "path": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/sha" }
      }
    },
    "toolchains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failureClass"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"] },
        "failureClass": { "enum": ["none", "compile", "test", "credentials", "runner-acquisition", "infrastructure", "cancelled", "other"] },
        "summary": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
          "then": { "properties": { "failureClass": { "const": "none" } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["FAIL", "NOT_RUN", "BLOCKED"] } }, "required": ["status"] },
          "then": { "not": { "properties": { "failureClass": { "const": "none" } }, "required": ["failureClass"] } }
        }
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "jobStarted", "stepsExecuted"],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "jobId": { "type": "integer", "minimum": 1 },
        "runnerId": { "type": ["integer", "null"], "minimum": 0 },
        "jobStarted": { "type": "boolean" },
        "stepsExecuted": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
  }
}
